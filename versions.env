# 组件版本默认值 —— 全仓库单一事实来源
#
# 写法说明: 用 ${VAR:-默认值}, 由 lib.sh 直接 source。
# ${VAR:-x} 的语义是"未设置或为空时取 x", 正好满足两种需求:
#   1. 已设置的环境变量原样保留 -> 优先级仍是 命令行 > 环境变量 > 本文件
#   2. CI 里上游版本获取失败时把变量置空, source 本文件即回落到固定版本
#
# 注意: 这里只是"不指定时用哪个版本"。多版本矩阵构建 (见 run-build-all.sh)
# 仍然靠命令行显式传参, 不受本文件约束。
#
# 查询各组件最新发布版: ./get-latest-versions.sh

# --- GNU 工具链 ---
BINUTILS_VER="${BINUTILS_VER:-2.47}"
GCC_VER="${GCC_VER:-16.2.0}"
GDB_VER="${GDB_VER:-17.2}"

# --- C 库 ---
GLIBC_VER="${GLIBC_VER:-2.44}"
MUSL_VER="${MUSL_VER:-1.2.6}"
NEWLIB_VER="${NEWLIB_VER:-4.6.0.20260123}"

# --- 内核 ---
LINUX_VER="${LINUX_VER:-7.2.2}"

# --- LLVM ---
LLVM_VER="${LLVM_VER:-22.1.8}"

# --- 镜像与工具 ---
BUSYBOX_VER="${BUSYBOX_VER:-1.38.0}"
QEMU_REF="${QEMU_REF:-v11.0.0}"
